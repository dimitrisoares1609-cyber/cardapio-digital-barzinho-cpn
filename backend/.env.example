# Porta e endereço público da API
PORT=3333
PUBLIC_URL=http://localhost:3333
# Origens liberadas no CORS (front em desenvolvimento)
CORS_ORIGINS=http://localhost:5173

# Banco PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cardapio

# Autenticação (troque o segredo em produção!)
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# Administrador criado pelo "npm run db:setup"
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@barzinhocpn.com.br
ADMIN_PASSWORD=admin123

# Armazenamento das imagens: local (pasta uploads) ou s3 (RustFS, AWS S3, Cloudflare R2...)
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cardapio
S3_ACCESS_KEY=cardapio
S3_SECRET_KEY=cardapio-segredo-123
