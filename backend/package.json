{
  "name": "cardapio-digital-api",
  "version": "1.0.0",
  "description": "API REST do Cardápio Digital do Barzinho CPN",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
